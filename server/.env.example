OPENAI_API_KEY=sk-...

# API -> n8n calls stay on the private Docker network (no ngrok, no internet hop).
# Use the PRODUCTION path (/webhook/...), not /webhook-test/...
N8N_START_URL=http://n8n:5678/webhook/REPLACE_WITH_YOUR_PATH
N8N_VERIFY_URL=http://n8n:5678/webhook/REPLACE_WITH_YOUR_PATH
N8N_CANCEL_URL=http://n8n:5678/webhook/REPLACE_WITH_YOUR_PATH
N8N_API_KEY=change-me